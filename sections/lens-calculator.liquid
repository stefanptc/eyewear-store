{{ 'lens-calculator.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <lens-calculator
    class="lens-calc page-width section-{{ section.id }}-padding"
    data-pricing-url="{{ 'lens-pricing-data.json' | asset_url }}"
    data-cart-add-url="{{ routes.cart_add_url }}"
    data-cart-url="{{ routes.cart_url }}"
  >
    {%- comment -%}
      All user-facing copy is injected here as a JSON island and consumed by
      the renderer (lens-calculator-ui.js). The renderer builds option cards,
      chips and result strings from this — never hard-coded in JS. Step option
      vocabularies (type/coating/light/index) are enumerated from the pricing
      data at runtime, so only the localized labels live here.
    {%- endcomment -%}
    <script type="application/json" data-lens-i18n>
      {
        "loading": {{ 'lens_calculator.loading' | t | json }},
        "unavailable": {{ 'lens_calculator.unavailable' | t | json }},
        "price_provisional": {{ 'lens_calculator.price_provisional' | t | json }},
        "errors_intro": {{ 'lens_calculator.errors_intro' | t | json }},
        "availability": {
          "stoc": {{ 'lens_calculator.availability.stoc' | t | json }},
          "comanda": {{ 'lens_calculator.availability.comanda' | t | json }},
          "comanda_5_7": {{ 'lens_calculator.availability.comanda_5_7' | t | json }}
        },
        "nudge": {
          "recommend_thinning": {{ 'lens_calculator.nudge.recommend_thinning' | t | json }}
        },
        "type": {
          "monofocal": {{ 'lens_calculator.type.monofocal' | t | json }},
          "bifocal": {{ 'lens_calculator.type.bifocal' | t | json }}
        },
        "coating": {
          "hmc": {{ 'lens_calculator.coating.hmc' | t | json }},
          "ultra_blue": {{ 'lens_calculator.coating.ultra_blue' | t | json }}
        },
        "light": {
          "clear": {{ 'lens_calculator.light.clear' | t | json }},
          "foto": {{ 'lens_calculator.light.foto' | t | json }},
          "transitions": {{ 'lens_calculator.light.transitions' | t | json }},
          "sun": {{ 'lens_calculator.light.sun' | t | json }}
        },
        "eye": {
          "od": {{ 'lens_calculator.eye.od' | t | json }},
          "os": {{ 'lens_calculator.eye.os' | t | json }}
        },
        "field": {
          "sph": {{ 'lens_calculator.field.sph' | t | json }},
          "cyl": {{ 'lens_calculator.field.cyl' | t | json }},
          "axis": {{ 'lens_calculator.field.axis' | t | json }},
          "add": {{ 'lens_calculator.field.add' | t | json }},
          "pd": {{ 'lens_calculator.field.pd' | t | json }}
        },
        "field_short": {
          "sph": {{ 'lens_calculator.field_short.sph' | t | json }},
          "cyl": {{ 'lens_calculator.field_short.cyl' | t | json }},
          "axis": {{ 'lens_calculator.field_short.axis' | t | json }},
          "add": {{ 'lens_calculator.field_short.add' | t | json }},
          "pd": {{ 'lens_calculator.field_short.pd' | t | json }}
        },
        "cart": {
          "add": {{ 'lens_calculator.cart.add' | t | json }},
          "adding": {{ 'lens_calculator.cart.adding' | t | json }},
          "unconfigured": {{ 'lens_calculator.cart.unconfigured' | t | json }},
          "error": {{ 'lens_calculator.cart.error' | t | json }},
          "pd_legend": {{ 'lens_calculator.cart.pd_legend' | t | json }},
          "prop": {
            "od": {{ 'lens_calculator.cart.prop.od' | t | json }},
            "os": {{ 'lens_calculator.cart.prop.os' | t | json }},
            "pd": {{ 'lens_calculator.cart.prop.pd' | t | json }},
            "add": {{ 'lens_calculator.cart.prop.add' | t | json }}
          }
        },
        "stepper": {
          "decrease": {{ 'lens_calculator.stepper.decrease' | t | json }},
          "increase": {{ 'lens_calculator.stepper.increase' | t | json }}
        },
        "guided": {
          "reset": {{ 'lens_calculator.guided.reset' | t | json }},
          "edit": {{ 'lens_calculator.guided.edit' | t | json }},
          "step": {
            "type": { "num": {{ 'lens_calculator.guided.step.type.num' | t | json }}, "label": {{ 'lens_calculator.guided.step.type.label' | t | json }} },
            "use": { "num": {{ 'lens_calculator.guided.step.use.num' | t | json }}, "label": {{ 'lens_calculator.guided.step.use.label' | t | json }}, "hint": {{ 'lens_calculator.guided.step.use.hint' | t | json }} },
            "coat": { "num": {{ 'lens_calculator.guided.step.coat.num' | t | json }}, "label": {{ 'lens_calculator.guided.step.coat.label' | t | json }} },
            "idx": { "num": {{ 'lens_calculator.guided.step.idx.num' | t | json }}, "label": {{ 'lens_calculator.guided.step.idx.label' | t | json }}, "hint": {{ 'lens_calculator.guided.step.idx.hint' | t | json }} },
            "foto_kind": { "num": {{ 'lens_calculator.guided.step.foto_kind.num' | t | json }}, "label": {{ 'lens_calculator.guided.step.foto_kind.label' | t | json }}, "hint": {{ 'lens_calculator.guided.step.foto_kind.hint' | t | json }} },
            "rx": { "num": {{ 'lens_calculator.guided.step.rx.num' | t | json }}, "label": {{ 'lens_calculator.guided.step.rx.label' | t | json }}, "hint": {{ 'lens_calculator.guided.step.rx.hint' | t | json }} }
          },
          "type_caption": {
            "monofocal": {{ 'lens_calculator.guided.type_caption.monofocal' | t | json }},
            "bifocal": {{ 'lens_calculator.guided.type_caption.bifocal' | t | json }}
          },
          "use_caption": {
            "clear": {{ 'lens_calculator.guided.use_caption.clear' | t | json }},
            "foto": {{ 'lens_calculator.guided.use_caption.foto' | t | json }},
            "sun": {{ 'lens_calculator.guided.use_caption.sun' | t | json }}
          },
          "coat_caption": {
            "hmc": {{ 'lens_calculator.guided.coat_caption.hmc' | t | json }},
            "ultra_blue": {{ 'lens_calculator.guided.coat_caption.ultra_blue' | t | json }}
          },
          "idx_caption": {
            "1.5": {{ 'lens_calculator.guided.idx_caption.1_5' | t | json }},
            "1.56": {{ 'lens_calculator.guided.idx_caption.1_56' | t | json }},
            "1.6": {{ 'lens_calculator.guided.idx_caption.1_6' | t | json }},
            "1.67": {{ 'lens_calculator.guided.idx_caption.1_67' | t | json }}
          },
          "idx_standard_label": {{ 'lens_calculator.guided.idx_standard_label' | t | json }},
          "foto_kind": {
            "foto": { "label": {{ 'lens_calculator.guided.foto_kind.foto.label' | t | json }}, "caption": {{ 'lens_calculator.guided.foto_kind.foto.caption' | t | json }} },
            "transitions": { "label": {{ 'lens_calculator.guided.foto_kind.transitions.label' | t | json }}, "caption": {{ 'lens_calculator.guided.foto_kind.transitions.caption' | t | json }} }
          },
          "chip": {
            "type": {{ 'lens_calculator.guided.chip.type' | t | json }},
            "use": {{ 'lens_calculator.guided.chip.use' | t | json }},
            "coat": {{ 'lens_calculator.guided.chip.coat' | t | json }},
            "idx": {{ 'lens_calculator.guided.chip.idx' | t | json }},
            "foto_kind": {{ 'lens_calculator.guided.chip.foto_kind' | t | json }}
          },
          "foto_kind_value": {
            "foto": {{ 'lens_calculator.guided.foto_kind_value.foto' | t | json }},
            "transitions": {{ 'lens_calculator.guided.foto_kind_value.transitions' | t | json }}
          },
          "add_legend": {{ 'lens_calculator.guided.add_legend' | t | json }},
          "result": {
            "tva": {{ 'lens_calculator.guided.result.tva' | t | json }},
            "product_tmpl": {{ 'lens_calculator.guided.result.product_tmpl' | t | json }},
            "type_noun": {
              "monofocal": {{ 'lens_calculator.guided.result.type_noun.monofocal' | t | json }},
              "bifocal": {{ 'lens_calculator.guided.result.type_noun.bifocal' | t | json }}
            },
            "light_noun": {
              "clear": {{ 'lens_calculator.guided.result.light_noun.clear' | t | json }},
              "foto": {{ 'lens_calculator.guided.result.light_noun.foto' | t | json }},
              "transitions": {{ 'lens_calculator.guided.result.light_noun.transitions' | t | json }},
              "sun": {{ 'lens_calculator.guided.result.light_noun.sun' | t | json }}
            }
          },
          "note": {
            "routing_title": {{ 'lens_calculator.guided.note.routing_title' | t | json }},
            "routing_body": {{ 'lens_calculator.guided.note.routing_body' | t | json }},
            "thinning_title": {{ 'lens_calculator.guided.note.thinning_title' | t | json }},
            "error_title": {{ 'lens_calculator.guided.note.error_title' | t | json }}
          }
        }
      }
    </script>

    {%- comment -%}
      rowId → variant id map. The lens product carries one variant per
      pricing-matrix row, joined by SKU = row id (e.g. M01 … B08; see
      docs/m4-lens-variant-metafields.md). The renderer looks up the chosen
      result's rowId here to POST the correct variant to /cart/add.js. Empty
      until the lens product is selected in the section settings (and is
      Active + on the Online Store channel) — the add button degrades to a
      "not yet available" message until then.
    {%- endcomment -%}
    <script type="application/json" data-lens-variant-map>
      {
        {%- assign lens_product = section.settings.lens_product -%}
        {%- if lens_product != blank -%}
          {%- assign sep = '' -%}
          {%- for variant in lens_product.variants -%}
            {%- if variant.sku != blank -%}
              {{ sep }}{{ variant.sku | json }}: {{ variant.id | json }}
              {%- assign sep = ',' -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      }
    </script>

    {%- if section.settings.heading != blank -%}
      <h2 class="lens-calc__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="lens-calc__intro rte">{{ section.settings.intro }}</div>
    {%- endif -%}

    {%- comment -%} Top bar: progress kicker + reset (revealed by JS once a choice is made). {%- endcomment -%}
    <div class="lens-calc__bar">
      <button type="button" class="lens-calc__reset" data-lens-reset hidden></button>
    </div>

    {%- comment -%} Answered steps collapse here as tappable chips (JS-populated). {%- endcomment -%}
    <div class="lens-calc__chips" data-lens-chips></div>

    {%- comment -%} Guided steps — one question at a time (JS-populated). {%- endcomment -%}
    <div class="lens-calc__steps" data-lens-steps></div>

    {%- comment -%}
      Result panel. Holds the parametric SVG preview (relocated, unchanged) plus
      the price/availability/notes body and the structured-error alert. The
      preview figure is decorative (aria-hidden); the [data-result] region is the
      polite live region that announces price/spec changes.
    {%- endcomment -%}
    <div class="lens-calc__result" data-result-panel hidden>
      <figure class="lens-preview" data-lens-preview hidden>
        <div class="lens-preview__panels">
          {%- comment -%}
            Panel 1 — front view (dominant, ~2/3). Static spectacle-lens
            silhouette; only the appearance overlays (tint / photochromic /
            sheen) and the bifocal D-region are state-driven. The clip and
            gradient ids are namespaced to section.id to stay unique.
          {%- endcomment -%}
          <div class="lens-preview__panel lens-preview__panel--front">
            <svg
              class="lens-preview__svg lens-preview__svg--front"
              viewBox="0 0 240 200"
              aria-hidden="true"
              role="presentation"
              focusable="false"
            >
              <defs>
                <clipPath id="lens-face-{{ section.id }}">
                  <rect x="25" y="25" width="190" height="150" rx="46" ry="52"></rect>
                </clipPath>
                <linearGradient id="lens-front-photo-{{ section.id }}" x1="0" y1="0" x2="0" y2="1">
                  <stop class="lens-preview__photo-stop lens-preview__photo-stop--top" offset="0"></stop>
                  <stop class="lens-preview__photo-stop lens-preview__photo-stop--bot" offset="1"></stop>
                </linearGradient>
                <linearGradient id="lens-front-sheen-{{ section.id }}" x1="0" y1="0" x2="1" y2="1">
                  <stop class="lens-preview__sheen-stop lens-preview__sheen-stop--a" offset="0"></stop>
                  <stop class="lens-preview__sheen-stop lens-preview__sheen-stop--b" offset="0.7"></stop>
                </linearGradient>
              </defs>
              <rect class="lens-preview__face" x="25" y="25" width="190" height="150" rx="46" ry="52"></rect>
              <rect class="lens-preview__front-tint" x="25" y="25" width="190" height="150" clip-path="url(#lens-face-{{ section.id }})"></rect>
              <rect class="lens-preview__front-photo" x="25" y="25" width="190" height="150" fill="url(#lens-front-photo-{{ section.id }})" clip-path="url(#lens-face-{{ section.id }})"></rect>
              <rect class="lens-preview__front-sheen" x="25" y="25" width="190" height="150" fill="url(#lens-front-sheen-{{ section.id }})" clip-path="url(#lens-face-{{ section.id }})"></rect>
              <path class="lens-preview__dseg" data-lens-front-seg clip-path="url(#lens-face-{{ section.id }})" d="M 55 122 L 185 122 L 185 148 Q 185 170 163 170 L 77 170 Q 55 170 55 148 Z" hidden></path>
              <rect class="lens-preview__front-spec" x="25" y="25" width="190" height="150" rx="46" ry="52"></rect>
            </svg>
            <span class="lens-preview__label">{{ 'lens_calculator.preview_front' | t }}</span>
          </div>

          {%- comment -%}
            Panel 2 — parametric side cross-section (~1/3). Geometry from
            geometryFrom(); paths carry data-lens-shape so the render path
            can repaint them. Unchanged profile logic.
          {%- endcomment -%}
          <div class="lens-preview__panel lens-preview__panel--side">
            <svg
              class="lens-preview__svg lens-preview__svg--side"
              viewBox="0 0 120 200"
              aria-hidden="true"
              role="presentation"
              focusable="false"
              data-lens-svg
            >
              <defs>
                <linearGradient id="lens-photo-{{ section.id }}" x1="0" y1="0" x2="0" y2="1">
                  <stop class="lens-preview__photo-stop lens-preview__photo-stop--top" offset="0"></stop>
                  <stop class="lens-preview__photo-stop lens-preview__photo-stop--bot" offset="1"></stop>
                </linearGradient>
              </defs>
              <path class="lens-preview__body" data-lens-shape></path>
              <path class="lens-preview__tint" data-lens-shape></path>
              <path class="lens-preview__photo" data-lens-shape fill="url(#lens-photo-{{ section.id }})"></path>
              <path class="lens-preview__sheen" data-lens-shape></path>
              <path class="lens-preview__spec" data-lens-shape></path>
              <line class="lens-preview__seg" data-lens-seg hidden></line>
            </svg>
            <span class="lens-preview__label">{{ 'lens_calculator.preview_side' | t }}</span>
          </div>
        </div>
        <figcaption class="lens-preview__caption">{{ 'lens_calculator.preview_caption' | t }}</figcaption>
      </figure>

      <div class="lens-calc__result-body">
        <div class="lens-calc__output" data-result aria-live="polite"></div>
        <div class="lens-calc__errors" data-errors role="alert" hidden></div>
      </div>
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="lens-calc__footnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </lens-calculator>
</div>

<script src="{{ 'lens-calculator-engine.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'lens-calculator-ui.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Calculator lentile",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titlu",
      "default": "Calculator lentile"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Text introductiv",
      "default": "<p>Alege tipul de lentilă și introdu rețeta ta. Prețul se actualizează pe măsură ce completezi.</p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Notă de subsol",
      "default": "Toate prețurile includ TVA."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schemă de culori",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Produs lentile"
    },
    {
      "type": "product",
      "id": "lens_product",
      "label": "Produsul de lentile",
      "info": "Produsul cu o variantă per rând din matricea de prețuri (SKU = codul rândului, ex. M01). Calculatorul adaugă în coș varianta cu SKU-ul corespunzător rezultatului."
    },
    {
      "type": "header",
      "content": "Spațiere"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Spațiere sus",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Spațiere jos",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Calculator lentile"
    }
  ]
}
{% endschema %}
